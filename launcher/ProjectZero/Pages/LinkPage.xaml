<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZero.Pages.LinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectZero.Controls"
    Background="{StaticResource PzBackground}"
    NavigationCacheMode="Disabled"
    RequiresPointer="Never"
    XYFocusKeyboardNavigation="Enabled"
    KeyDown="Page_KeyDown">

    <Grid>
        <Image Source="https://cdn2.unrealengine.com/Fortnite%2Fblog%2Ftake-to-the-skies-in-season-7%2FBR07_News_Featured_16_9-1920x1080-c8c58d82b2986bf9615c839d53bb7763c06895c5.jpg"
               Stretch="UniformToFill" Opacity="0.92" />
        <Rectangle Fill="{StaticResource PzHeroScrim}" />
        <Rectangle Fill="#4A07101C" />

        <Grid Padding="58,38,58,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                    <controls:BrandMark Width="46" Height="46" />
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="PROJECT ZERO" Style="{StaticResource PzDisplay}" FontSize="23" />
                        <TextBlock Text="SEASON 7 / XBOX DEV MODE" Style="{StaticResource PzMono}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#B00C121A" BorderBrush="#669CB2C9" BorderThickness="1"
                        CornerRadius="2" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource PzOkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="ONLINE" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.78*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" MaxWidth="760" Margin="0,0,44,0">
                    <TextBlock Text="PAIR YOUR CONSOLE" Style="{StaticResource PzEyebrow}" />
                    <TextBlock Text="LINK THIS XBOX" Style="{StaticResource PzDisplay}"
                               FontSize="64" Margin="0,5,0,0" />
                    <TextBlock Text="Open the link on your phone or scan the QR code, then enter the code shown below."
                               FontFamily="Segoe UI" FontSize="17" Foreground="#FFE6EDF7"
                               TextWrapping="Wrap" MaxWidth="700" Margin="0,6,0,0" />

                    <Border Background="#DC0B1018" BorderBrush="#7AA7BED5" BorderThickness="1"
                            CornerRadius="2" Padding="22,13" Margin="0,28,0,0"
                            Width="650" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="104">
                            <TextBlock x:Name="CodeText" Text="------"
                                       FontFamily="Consolas" FontSize="92" FontWeight="Bold"
                                       CharacterSpacing="90" Foreground="White" />
                        </Viewbox>
                    </Border>

                    <TextBlock x:Name="LinkUrlText" Text="PROJECTZERO7.VERCEL.APP/LINK"
                               FontFamily="Segoe UI Semibold" FontSize="13" CharacterSpacing="55"
                               Foreground="{StaticResource PzIceBrush}" Margin="1,13,0,0" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,24,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                 Fill="{StaticResource PzVioletBrightBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="REQUESTING CODE"
                                   Style="{StaticResource PzMono}" Foreground="White"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Height="4" Width="520" HorizontalAlignment="Left" Margin="0,14,0,0"
                          Background="#802D3C4E">
                        <Rectangle x:Name="PulseBar" Width="150" Height="4" HorizontalAlignment="Left"
                                   Fill="{StaticResource PzBarGradient}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="PulseTransform" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                               FontFamily="Segoe UI Semibold" FontSize="12"
                               Foreground="{StaticResource PzDangerBrush}"
                               TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left"
                               Margin="0,14,0,0" />

                    <Button x:Name="RefreshButton" Content="REFRESH CODE"
                            Style="{StaticResource PzGhostButton}" HorizontalAlignment="Left"
                            Margin="0,18,0,0" Click="Refresh_Click" />
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Background="#E20B1119" BorderBrush="#88A8BED5" BorderThickness="1"
                        CornerRadius="2" Padding="26">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SCAN TO LINK" Style="{StaticResource PzEyebrow}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="USE YOUR PHONE CAMERA"
                                   Style="{StaticResource PzMono}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />

                        <Border Background="White" BorderBrush="White" BorderThickness="8"
                                CornerRadius="0" Margin="0,20,0,0" Width="302" Height="302">
                            <Grid Background="White">
                                <Image x:Name="QrImage" Width="286" Height="286"
                                       Stretch="Fill" Opacity="1" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="QrHelpText"
                                   Text="The QR code opens the same secure console-link page as the code."
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#FFD6DFEA"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="300" Margin="0,17,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Border Height="1" Background="#6A9CB2C9" VerticalAlignment="Top" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="28">
                    <TextBlock Text="D-PAD / LEFT STICK  NAVIGATE" Style="{StaticResource PzMono}" Foreground="White" />
                    <TextBlock Text="A  SELECT" Style="{StaticResource PzMono}" Foreground="White" />
                    <TextBlock Text="B  EXIT" Style="{StaticResource PzMono}" Foreground="White" />
                </StackPanel>
                <TextBlock Text="7.00 / CL-4629139" Style="{StaticResource PzMono}"
                           Foreground="#FFDCE6F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
