<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZero.Pages.LinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectZero.Controls"
    Background="{StaticResource PzBackground}"
    NavigationCacheMode="Disabled"
    RequiresPointer="Never"
    XYFocusKeyboardNavigation="Enabled"
    KeyDown="Page_KeyDown">

    <Grid Padding="54,34,54,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                <controls:BrandMark Width="43" Height="43" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="PROJECT ZERO" Style="{StaticResource PzDisplay}" FontSize="21" />
                    <TextBlock Text="SEASON 7 · XBOX" Style="{StaticResource PzMono}" FontSize="10" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Ellipse Width="8" Height="8" Fill="{StaticResource PzOkBrush}" />
                <TextBlock Text="DEV MODE" Style="{StaticResource PzMono}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Bottom" />

        <Grid Grid.Row="1" Margin="0,28,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,42,0">
                <StackPanel VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="LINK THIS XBOX" Style="{StaticResource PzEyebrow}" />
                    <TextBlock Text="ENTER THE CODE" Style="{StaticResource PzDisplay}" FontSize="54" Margin="0,8,0,0" />
                    <TextBlock Text="Use the QR code or open the address below on another device."
                               Style="{StaticResource PzMono}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Border Background="#D90D0D12" BorderBrush="{StaticResource PzLineBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="18,12" Margin="0,28,0,0" MaxWidth="650" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Width="610" Height="104">
                            <TextBlock x:Name="CodeText" Text="------"
                                       FontFamily="Consolas" FontSize="92" FontWeight="Bold"
                                       CharacterSpacing="110" Foreground="{StaticResource PzTextBrush}" />
                        </Viewbox>
                    </Border>

                    <TextBlock x:Name="LinkUrlText" Text="PROJECTZERO7.VERCEL.APP/LINK"
                               Style="{StaticResource PzMono}" FontSize="12"
                               Foreground="{StaticResource PzVioletBrightBrush}" Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,27,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                 Fill="{StaticResource PzVioletBrightBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="WAITING FOR CLAIM"
                                   Style="{StaticResource PzMono}" Foreground="{StaticResource PzTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Height="4" Width="520" HorizontalAlignment="Left" Margin="0,15,0,0" Background="#FF1B1B23">
                        <Rectangle x:Name="PulseBar" Width="150" Height="4" HorizontalAlignment="Left"
                                   Fill="{StaticResource PzBarGradient}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="PulseTransform" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                               Style="{StaticResource PzMono}" Foreground="#FFFFB4C2"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               Margin="0,18,0,0" />

                    <Button x:Name="RefreshButton" Content="REFRESH CODE"
                            Style="{StaticResource PzGhostButton}" HorizontalAlignment="Left"
                            Margin="0,22,0,0" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PzPanel}" VerticalAlignment="Center"
                    HorizontalAlignment="Right" MinWidth="330">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SCAN TO LINK" Style="{StaticResource PzEyebrow}" HorizontalAlignment="Center" />
                    <Border Background="#FFFFFFFF" Padding="12" CornerRadius="4" Margin="0,20,0,0">
                        <Image x:Name="QrImage" Width="238" Height="238" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="The QR code and six-character code open the same link."
                               Style="{StaticResource PzMono}" FontSize="10" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="270" Margin="0,17,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="◀▶▲▼  D-PAD / LEFT STICK" Style="{StaticResource PzMono}" />
                <TextBlock Text="A  SELECT" Style="{StaticResource PzMono}" />
                <TextBlock Text="B  EXIT" Style="{StaticResource PzMono}" />
            </StackPanel>
            <TextBlock Text="PROJECT ZERO · 7.00 / CL-4629139" Style="{StaticResource PzMono}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
