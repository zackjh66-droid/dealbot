<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZero.Pages.LinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectZero.Controls"
    Background="{StaticResource PzBackground}"
    NavigationCacheMode="Disabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="84" />
        </Grid.RowDefinitions>

        <Path Grid.RowSpan="3"
              Data="M0,0 L430,0 L270,1080 L0,1080 Z"
              Fill="#141024" Opacity="0.42"
              HorizontalAlignment="Right" Stretch="Fill" Width="430"
              IsHitTestVisible="False" />

        <Grid Grid.Row="0" Margin="64,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                <controls:BrandMark Width="36" Height="36" />
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="PROJECT ZERO" Style="{StaticResource PzDisplay}" FontSize="18" CharacterSpacing="260" />
                    <TextBlock Text="CONSOLE DIVISION" Style="{StaticResource PzMono}" FontSize="9" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Ellipse Width="7" Height="7" Fill="{StaticResource PzOkBrush}" VerticalAlignment="Center" />
                <TextBlock Text="XBOX DEV MODE · v1.0.0" Style="{StaticResource PzMono}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1" Margin="64,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CONSOLE LINK" Style="{StaticResource PzEyebrow}" />
                <TextBlock x:Name="CodeText" Text="------"
                           FontFamily="Consolas" FontSize="128" CharacterSpacing="150"
                           Foreground="#FFFFFFFF" Margin="0,8,0,0" />
                <TextBlock x:Name="LinkUrlText" Text="CONTROL PLANE"
                           Style="{StaticResource PzMono}" FontSize="14"
                           Foreground="{StaticResource PzVioletBrightBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,46,0,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{StaticResource PzGoldBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="WAITING FOR CLAIM"
                               Style="{StaticResource PzMono}"
                               Foreground="{StaticResource PzTextBrush}" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Height="4" Width="470" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#FF171226">
                    <Rectangle x:Name="PulseBar" Width="180" Height="4" HorizontalAlignment="Left"
                               Fill="{StaticResource PzBarGradient}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="PulseTransform" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <TextBlock x:Name="ErrorText" Visibility="Collapsed"
                           Style="{StaticResource PzMono}" Foreground="#FFFFB3C1"
                           TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                           Margin="0,24,0,0" />

                <Button x:Name="RefreshButton" Content="REFRESH CODE"
                        Style="{StaticResource PzGhostButton}"
                        HorizontalAlignment="Left" Margin="0,34,0,0"
                        Click="Refresh_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#FFF7F3FF" Padding="14">
                    <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform" />
                </Border>
                <TextBlock Text="SCAN OR TYPE THE CODE" Style="{StaticResource PzMono}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="64,0">
            <Border Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="30">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Background="#FF1A1530" CornerRadius="11" Width="22" Height="22">
                        <TextBlock Text="A" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource PzGoldBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="REFRESH CODE" Style="{StaticResource PzMono}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Background="#FF1A1530" CornerRadius="11" Width="22" Height="22">
                        <TextBlock Text="B" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource PzGoldBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EXIT" Style="{StaticResource PzMono}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="CONTROL PLANE · PROJECT ZERO" Style="{StaticResource PzMono}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
