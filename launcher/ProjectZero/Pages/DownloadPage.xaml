<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZero.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectZero.Controls"
    Background="{StaticResource PzBackground}"
    NavigationCacheMode="Disabled"
    RequiresPointer="Never"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="54,34,54,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                <controls:BrandMark Width="43" Height="43" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="PROJECT ZERO" Style="{StaticResource PzDisplay}" FontSize="21" />
                    <TextBlock Text="CONTENT DELIVERY" Style="{StaticResource PzMono}" FontSize="10" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource PzVioletBrightBrush}" />
                <TextBlock x:Name="TopStateText" Text="PREPARING" Style="{StaticResource PzMono}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Bottom" />

        <Grid Grid.Row="1" Margin="0,30,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,42,0">
                <TextBlock Text="SEASON 7 CONTENT" Style="{StaticResource PzEyebrow}" />
                <TextBlock x:Name="BuildTitle" Text="FORTNITE 7.00"
                           Style="{StaticResource PzDisplay}" FontSize="58" Margin="0,8,0,0" />
                <TextBlock x:Name="BuildSubtitle" Text="CL-4629139 · VERIFIED CONTENT"
                           Style="{StaticResource PzMono}" FontSize="12" />

                <TextBlock x:Name="DownloadStateText" Text="CHECKING CONTENT MANIFEST"
                           Style="{StaticResource PzMono}" FontSize="12" Foreground="{StaticResource PzTextBrush}"
                           Margin="0,38,0,0" />

                <Grid x:Name="ProgressTrack" Height="10" Width="640" HorizontalAlignment="Left"
                      Margin="0,16,0,0" Background="#FF1B1B23">
                    <Rectangle x:Name="DownloadProgressFill" Width="0" Height="10" HorizontalAlignment="Left"
                               Fill="{StaticResource PzBarGradient}" />
                </Grid>

                <Grid Width="640" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBlock x:Name="PercentText" Text="0%" Style="{StaticResource PzDisplay}" FontSize="30" />
                    <TextBlock x:Name="BytesText" Text="0 MB / —" Style="{StaticResource PzMono}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="DetailText"
                           Text="Project Zero verifies every downloaded file before it is made available to the client."
                           Style="{StaticResource PzMono}" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="640" HorizontalAlignment="Left" Margin="0,20,0,0" LineHeight="19" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,25,0,0">
                    <Button x:Name="RetryButton" Content="RETRY" Visibility="Collapsed"
                            Style="{StaticResource PzButton}" Click="Retry_Click" />
                    <Button x:Name="ContinueButton" Content="CONTINUE" Visibility="Collapsed"
                            Style="{StaticResource PzButton}" Click="Continue_Click" />
                    <Button x:Name="CancelButton" Content="CANCEL" Visibility="Collapsed"
                            Style="{StaticResource PzGhostButton}" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PzPanel}" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="BUILD" Style="{StaticResource PzEyebrow}" />
                    <Grid Margin="0,22,0,0">
                        <TextBlock Text="VERSION" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock x:Name="VersionValue" Text="7.00" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource PzLineBrush}" Margin="0,12" />
                    <Grid>
                        <TextBlock Text="CHANGE LIST" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock x:Name="ClValue" Text="4629139" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource PzLineBrush}" Margin="0,12" />
                    <Grid>
                        <TextBlock Text="CURRENT FILE" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock x:Name="FileValue" Text="—" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzTextBrush}" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="205" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource PzLineBrush}" Margin="0,12" />
                    <Grid>
                        <TextBlock Text="INTEGRITY" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock x:Name="IntegrityValue" Text="PENDING" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzVioletBrightBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="The launcher restores the authorized build into ProjectZeroContent using the original Engine/ and FortniteGame/ paths."
                               Style="{StaticResource PzMono}" FontSize="10" TextWrapping="Wrap" LineHeight="18"
                               Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="◀▶▲▼  D-PAD / LEFT STICK" Style="{StaticResource PzMono}" />
                <TextBlock Text="A  SELECT" Style="{StaticResource PzMono}" />
            </StackPanel>
            <TextBlock Text="BACKGROUND TRANSFER · SHA-256" Style="{StaticResource PzMono}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
