<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZero.Pages.HandoffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectZero.Controls"
    Background="{StaticResource PzBackground}"
    NavigationCacheMode="Disabled"
    RequiresPointer="Never"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="54,34,54,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                <controls:BrandMark Width="43" Height="43" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="PROJECT ZERO" Style="{StaticResource PzDisplay}" FontSize="21" />
                    <TextBlock Text="SEASON 7 · XBOX" Style="{StaticResource PzMono}" FontSize="10" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Ellipse Width="8" Height="8" Fill="{StaticResource PzOkBrush}" />
                <TextBlock Text="SESSION ACTIVE" Style="{StaticResource PzMono}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Bottom" />

        <Grid Grid.Row="1" Margin="0,30,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,44,0">
                <TextBlock Text="READY TO LAUNCH" Style="{StaticResource PzEyebrow}" />
                <TextBlock x:Name="UsernameText" Text="PLAYER"
                           Style="{StaticResource PzDisplay}" FontSize="56" Margin="0,7,0,0" />
                <TextBlock x:Name="AccountLineText" Text="ACCOUNT · SEASON 7"
                           Style="{StaticResource PzMono}" FontSize="12" />

                <Border Background="#9E0C0C11" BorderBrush="{StaticResource PzLineBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="20" Margin="0,32,0,0" MaxWidth="650" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="LogProfile" Text="PROFILE MOUNTED" Style="{StaticResource PzMono}" FontSize="11" />
                        <TextBlock x:Name="LogBuild" Text="BUILD RESOLVED" Style="{StaticResource PzMono}" FontSize="11" />
                        <TextBlock x:Name="LogTicket" Text="GAME TICKET" Style="{StaticResource PzMono}" FontSize="11" />
                        <TextBlock x:Name="LogHandoff" Text="CLIENT HANDOFF" Style="{StaticResource PzMono}" FontSize="11" />
                    </StackPanel>
                </Border>

                <Grid Height="4" Width="520" HorizontalAlignment="Left" Margin="0,24,0,0" Background="#FF1B1B23">
                    <Rectangle x:Name="ProgressFill" Width="30" Height="4" HorizontalAlignment="Left"
                               Fill="{StaticResource PzBarGradient}" />
                </Grid>

                <TextBlock x:Name="StatusText" Text="NEGOTIATING SESSION"
                           Style="{StaticResource PzMono}" FontSize="12"
                           Foreground="{StaticResource PzTextBrush}" Margin="0,16,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PzPanel}" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CLIENT HANDOFF" Style="{StaticResource PzEyebrow}" />

                    <Grid Margin="0,22,0,0">
                        <TextBlock Text="TARGET" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock Text="XBOX · UWP · x64" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource PzLineBrush}" Margin="0,12" />
                    <Grid>
                        <TextBlock Text="BUILD" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock x:Name="BuildText" Text="—" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource PzLineBrush}" Margin="0,12" />
                    <Grid>
                        <TextBlock Text="PROTOCOL" Style="{StaticResource PzMono}" FontSize="10" />
                        <TextBlock Text="projectzero-game" Style="{StaticResource PzMono}" FontSize="10"
                                   Foreground="{StaticResource PzVioletBrightBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock x:Name="ClientStateText" Text="AWAITING HANDOFF"
                               Style="{StaticResource PzMono}" FontSize="11"
                               Foreground="{StaticResource PzVioletBrightBrush}" Margin="0,22,0,0" />
                    <TextBlock x:Name="ClientHelpText" Visibility="Collapsed"
                               Style="{StaticResource PzMono}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="18" />

                    <Button x:Name="RetryButton" Content="RETRY HANDOFF" Visibility="Collapsed"
                            Style="{StaticResource PzButton}" HorizontalAlignment="Stretch"
                            Margin="0,20,0,0" Click="Retry_Click" />
                    <Button x:Name="UnlinkButton" Content="UNLINK CONSOLE"
                            Style="{StaticResource PzGhostButton}" HorizontalAlignment="Stretch"
                            Margin="0,11,0,0" Click="Unlink_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Height="1" Background="{StaticResource PzLineBrush}" VerticalAlignment="Top" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="◀▶▲▼  D-PAD / LEFT STICK" Style="{StaticResource PzMono}" />
                <TextBlock Text="A  SELECT" Style="{StaticResource PzMono}" />
                <TextBlock Text="B  BACK" Style="{StaticResource PzMono}" />
            </StackPanel>
            <TextBlock x:Name="FooterText" Text="7.00 / CL-4629139" Style="{StaticResource PzMono}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
