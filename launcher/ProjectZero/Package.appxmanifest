<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="ProjectZero.Launcher"
    Publisher="CN=Project Zero"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity
    PhoneProductId="7a1b9c11-3e44-4f0a-9d77-2b5c1a8e6f21"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Project Zero</DisplayName>
    <PublisherDisplayName>Project Zero</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ProjectZero.App">
      <uap:VisualElements
        AppListEntry="default"
        DisplayName="Project Zero"
        Description="Season 7 console launcher for Xbox Dev Mode"
        BackgroundColor="#08090D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Project Zero" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#08090D" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Extensions>
    <Extension Category="windows.publisherCacheFolders">
      <PublisherCacheFolders>
        <Folder Name="ProjectZeroContent" />
      </PublisherCacheFolders>
    </Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
