<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PzInkColor">#FF08080B</Color>
    <Color x:Key="PzPanelColor">#F0121218</Color>
    <Color x:Key="PzLineColor">#FF2A2A34</Color>
    <Color x:Key="PzVioletColor">#FF7C3AED</Color>
    <Color x:Key="PzVioletBrightColor">#FFA78BFA</Color>
    <Color x:Key="PzGoldColor">#FFA78BFA</Color>
    <Color x:Key="PzMutedColor">#FFA1A1AA</Color>
    <Color x:Key="PzTextColor">#FFF8F8FA</Color>
    <Color x:Key="PzOkColor">#FF4ADE80</Color>

    <SolidColorBrush x:Key="PzPanelBrush" Color="{StaticResource PzPanelColor}" />
    <SolidColorBrush x:Key="PzLineBrush" Color="{StaticResource PzLineColor}" />
    <SolidColorBrush x:Key="PzVioletBrush" Color="{StaticResource PzVioletColor}" />
    <SolidColorBrush x:Key="PzVioletBrightBrush" Color="{StaticResource PzVioletBrightColor}" />
    <SolidColorBrush x:Key="PzGoldBrush" Color="{StaticResource PzGoldColor}" />
    <SolidColorBrush x:Key="PzMutedBrush" Color="{StaticResource PzMutedColor}" />
    <SolidColorBrush x:Key="PzTextBrush" Color="{StaticResource PzTextColor}" />
    <SolidColorBrush x:Key="PzOkBrush" Color="{StaticResource PzOkColor}" />

    <LinearGradientBrush x:Key="PzBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF070709" Offset="0" />
        <GradientStop Color="#FF0B0911" Offset="0.62" />
        <GradientStop Color="#FF100B1C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PzGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B5CF6" Offset="0" />
        <GradientStop Color="#FF6D28D9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PzBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6D28D9" Offset="0" />
        <GradientStop Color="#FFA78BFA" Offset="0.72" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PzEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="240" />
        <Setter Property="Foreground" Value="{StaticResource PzVioletBrightBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PzMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="105" />
        <Setter Property="Foreground" Value="{StaticResource PzMutedBrush}" />
    </Style>

    <Style x:Key="PzDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Black" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="CharacterSpacing" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource PzTextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="PzPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PzPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PzLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="26" />
    </Style>

    <Style x:Key="PzButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PzVioletBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource PzVioletBrightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Padding" Value="28,15" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="#FFFFFFFF" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource PzVioletBrightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Surface"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.90" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.06" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PzGhostButton" TargetType="Button">
        <Setter Property="Background" Value="#14000000" />
        <Setter Property="Foreground" Value="{StaticResource PzTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PzLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Padding" Value="28,15" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="#FFFFFFFF" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource PzVioletBrightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Surface"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.58" Duration="0:0:0.06" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
