<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PzInkColor">#FF06050A</Color>
    <Color x:Key="PzPanelColor">#F2120E1E</Color>
    <Color x:Key="PzLineColor">#FF2A2140</Color>
    <Color x:Key="PzVioletColor">#FF8B5CF6</Color>
    <Color x:Key="PzVioletBrightColor">#FFC4A1FF</Color>
    <Color x:Key="PzGoldColor">#FFF2C45A</Color>
    <Color x:Key="PzMutedColor">#FF948BA9</Color>
    <Color x:Key="PzTextColor">#FFF0EBFF</Color>
    <Color x:Key="PzOkColor">#FF6EE7B7</Color>

    <SolidColorBrush x:Key="PzPanelBrush" Color="{StaticResource PzPanelColor}" />
    <SolidColorBrush x:Key="PzLineBrush" Color="{StaticResource PzLineColor}" />
    <SolidColorBrush x:Key="PzVioletBrush" Color="{StaticResource PzVioletColor}" />
    <SolidColorBrush x:Key="PzVioletBrightBrush" Color="{StaticResource PzVioletBrightColor}" />
    <SolidColorBrush x:Key="PzGoldBrush" Color="{StaticResource PzGoldColor}" />
    <SolidColorBrush x:Key="PzMutedBrush" Color="{StaticResource PzMutedColor}" />
    <SolidColorBrush x:Key="PzTextBrush" Color="{StaticResource PzTextColor}" />
    <SolidColorBrush x:Key="PzOkBrush" Color="{StaticResource PzOkColor}" />

    <LinearGradientBrush x:Key="PzBackground" StartPoint="0.86,0" EndPoint="0.14,1">
        <GradientStop Color="#FF0C0818" Offset="0" />
        <GradientStop Color="#FF06050A" Offset="0.7" />
        <GradientStop Color="#FF090614" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PzGoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF8D67E" Offset="0" />
        <GradientStop Color="#FFF2C45A" Offset="0.55" />
        <GradientStop Color="#FFD9A63C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PzBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8B5CF6" Offset="0" />
        <GradientStop Color="#FFC4A1FF" Offset="0.6" />
        <GradientStop Color="#FFF2C45A" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PzEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="300" />
        <Setter Property="Foreground" Value="{StaticResource PzGoldBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PzMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource PzMutedBrush}" />
    </Style>

    <Style x:Key="PzDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource PzTextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="PzPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PzPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PzLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="30" />
    </Style>

    <Style x:Key="PzButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PzGoldGradient}" />
        <Setter Property="Foreground" Value="#FF120C02" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Padding" Value="30,16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="#FFFFFFFF" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource PzGoldBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PzGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PzTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PzLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Padding" Value="30,16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="#FFFFFFFF" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource PzGoldBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
