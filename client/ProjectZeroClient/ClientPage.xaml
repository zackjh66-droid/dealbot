<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectZeroClient.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource Bg}"
    RequiresPointer="Never"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="64,42,64,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                <Viewbox Width="42" Height="42">
                    <Grid Width="48" Height="48">
                        <Ellipse Width="42" Height="42" Stroke="{StaticResource Fg}" StrokeThickness="4.5" />
                        <Ellipse Width="26" Height="26" Fill="{StaticResource Bg}" />
                        <Path Data="M11,37 L37,11" Stroke="{StaticResource Accent}" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M14,40 L40,14" Stroke="{StaticResource AccentStrong}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Viewbox>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="PROJECT ZERO" Foreground="{StaticResource Fg}"
                               FontFamily="Segoe UI Black" FontSize="21" FontWeight="Black" />
                    <TextBlock Text="SEASON 7 · XBOX CLIENT" Foreground="{StaticResource Muted}"
                               FontFamily="Consolas" FontSize="10" CharacterSpacing="105" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="CLIENT BRIDGE" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                       FontSize="11" CharacterSpacing="140" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="0" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />

        <Grid Grid.Row="1" Margin="0,34,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,46,0">
                <TextBlock Text="HANDOFF RECEIVED" Foreground="{StaticResource Accent}"
                           FontFamily="Consolas" FontSize="12" CharacterSpacing="190" />
                <TextBlock Text="STARTING SESSION"
                           Foreground="{StaticResource Fg}" FontFamily="Segoe UI Black"
                           FontSize="58" FontWeight="Black" Margin="0,8,0,0" />
                <TextBlock Text="Project Zero is checking the authenticated session and verified Season 7 content before the runtime starts."
                           Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="16"
                           TextWrapping="Wrap" MaxWidth="690" Margin="0,12,0,0" />
                <TextBlock Text="7.00 · CL-4629139" Foreground="{StaticResource Accent}"
                           FontFamily="Consolas" FontSize="12" CharacterSpacing="130" Margin="0,24,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="24" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="RUNTIME STATUS" Foreground="{StaticResource Accent}"
                               FontFamily="Consolas" FontSize="11" CharacterSpacing="160" />
                    <TextBlock x:Name="PayloadText" TextWrapping="Wrap" Foreground="{StaticResource Fg}"
                               FontFamily="Consolas" FontSize="13" Margin="0,18,0,0" LineHeight="21" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Top" />
            <TextBlock Text="PROJECT ZERO · VERIFIED CONTENT HANDOFF" Foreground="{StaticResource Muted}"
                       FontFamily="Consolas" FontSize="10" CharacterSpacing="110" VerticalAlignment="Center" />
            <TextBlock Text="XBOX DEV MODE" Foreground="{StaticResource Muted}"
                       FontFamily="Consolas" FontSize="10" CharacterSpacing="110"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
