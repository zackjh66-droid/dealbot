 <Applications><Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ProjectZeroClient.App"><uap:VisualElements DisplayName="Project Zero Client" Description="Project Zero Xbox client bridge" BackgroundColor="#06050A" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"><uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png"/><uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#06050A"/></uap:VisualElements><Extensions><uap:Extension Category="windows.protocol"><uap:Protocol Name="projectzero-game"><uap:DisplayName>Project Zero Game Client</uap:DisplayName></uap:Protocol></uap:Extension></Extensions></Application></Applications>
