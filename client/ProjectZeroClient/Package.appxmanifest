 <Identity Name="ProjectZero.ClientBridge" Publisher="CN=Project Zero" Version="1.0.0.0" ProcessorArchitecture="x64"/>
 <Properties><DisplayName>Project Zero Client Bridge</DisplayName><PublisherDisplayName>Project Zero</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
